#!/system/bin/sh
# DaePilot data-plane controller.
#
# All daemon lifecycle operations live here so the app, the boot service and
# the watchdog share one implementation. dae runs inside a chroot under
# /data/adb/daepilot/rootfs, detached from the calling (app) process.
#
# Mount safety: the chroot is prepared in a private mount namespace created by
# `unshare -m`. Its mounts (including the /dev rbind) are destroyed with the
# namespace, so the shared host namespace is never mounted into or umounted
# from. This prevents mount propagation from tearing down /dev/binderfs.
#
# Commands: start stop restart reload enable disable apply validate status logs
#           clearlog diagnose watch

BASE="${DAEPILOT_BASE:-/data/adb/daepilot}"
ROOTFS="$BASE/rootfs"
DAE="$BASE/bin/dae"
CTL="$BASE/bin/daepilotctl"
GEO_DIR="$BASE/geo"
CONF_DIR="$BASE/config"
CONF="$CONF_DIR/config.dae"
BAK="$CONF_DIR/config.dae.bak"
VALIDATE_CONF_GUEST="/config/config.validate.dae"
VALIDATE_CONF="$ROOTFS$VALIDATE_CONF_GUEST"
DAE_MARK_RULE_PRIORITY=9900
DAE_MARK_LEGACY_PRIORITY=14000
STAGING="$BASE/staging"
RUN="$BASE/run"
LOG="$BASE/logs/dae.log"
WLOG="$BASE/logs/watchdog.log"
HOST_PID="$RUN/dae.host.pid"
DAE_PID="$ROOTFS/run/dae.pid"
WATCH_PID="$RUN/watchdog.pid"
DNS_SERVERS="$RUN/dns.servers"
CONNECTIVITY_DUMP="$RUN/connectivity.dump"
ENABLED="$BASE/enabled"
BOOT_ENABLED="$BASE/boot_enabled"
VERSION_FILE="$BASE/bin/VERSION"
CONFIG_OK="$RUN/config.ok"
LAST_ERROR="$RUN/last_error"
WAN_FILE="$RUN/wan.interface"
WAN_AUTO="$RUN/wan.auto"
WAN_CANDIDATE="$RUN/wan.candidate"
WAN_CANDIDATE_COUNT="$RUN/wan.candidate.count"
NODE_HOSTS_CACHE="$RUN/node.hosts"

BB=""
for candidate in /data/adb/magisk/busybox /data/adb/ksu/bin/busybox /data/adb/ap/bin/busybox /system/xbin/busybox; do
  if [ -x "$candidate" ]; then BB="$candidate"; break; fi
done
if [ -z "$BB" ] && command -v busybox >/dev/null 2>&1; then
  BB="$(command -v busybox)"
fi

say() { echo "$*"; }
fail() { echo "$*" >&2; set_error "$*"; return 1; }

set_error() {
  mkdir -p "$RUN" 2>/dev/null
  printf '%s\n' "$1" > "$LAST_ERROR" 2>/dev/null
}

clear_error() { rm -f "$LAST_ERROR" 2>/dev/null; }

have() { command -v "$1" >/dev/null 2>&1; }

# dae loads geoip/geosite into BPF LPM tries at startup. Android caps locked
# memory at 64 KiB, and a map update that cannot charge its pages fails with
# "newLpmMap: batch update: cannot allocate memory", which aborts the daemon
# before it creates the tproxy listener. Raising the soft limit is harmless on
# kernels that charge BPF memory to the cgroup instead.
raise_memlock() {
  ulimit -l unlimited 2>/dev/null || true
}

ensure_layout() {
  mkdir -p "$BASE/bin" "$CONF_DIR" "$STAGING" "$RUN" "$BASE/logs" 2>/dev/null
  mkdir -p "$ROOTFS/bin" "$ROOTFS/config" "$ROOTFS/run" "$ROOTFS/proc" \
    "$ROOTFS/sys/class" "$ROOTFS/sys/devices" "$ROOTFS/sys/fs/cgroup" \
    "$ROOTFS/sys/fs/bpf" "$ROOTFS/sys/kernel/btf" "$ROOTFS/dev" \
    "$ROOTFS/etc/ssl/certs" "$ROOTFS/tmp" "$ROOTFS/var" "$ROOTFS/root" 2>/dev/null
  chmod 700 "$BASE" "$CONF_DIR" 2>/dev/null
  chmod 755 "$ROOTFS" "$ROOTFS/bin" "$ROOTFS/run" "$ROOTFS/etc" "$ROOTFS/var" 2>/dev/null
  chmod 1777 "$ROOTFS/tmp" 2>/dev/null
  if [ ! -L "$ROOTFS/var/run" ]; then
    rm -rf "$ROOTFS/var/run" 2>/dev/null
    ln -s ../run "$ROOTFS/var/run" 2>/dev/null
  fi
  [ -f "$LOG" ] || : > "$LOG"
  [ -f "$WLOG" ] || : > "$WLOG"
}

is_mounted() {
  # mountpoint(1) avoids parsing /proc/mounts entirely. The fallback reads the
  # table instead of `grep -q`: on some shells/OSes /proc/mounts is a synthetic
  # pipe and an early-exiting grep can leave the reader blocked.
  if have mountpoint; then
    mountpoint -q "$1" 2>/dev/null
    return $?
  fi
  local mount_point
  while IFS=' ' read -r _ mount_point _; do
    [ "$mount_point" = "$1" ] && return 0
  done < /proc/mounts 2>/dev/null
  return 1
}
ensure_mounts() {
  # Only ever called from exec_in_private_ns. Mounting from the shared host
  # namespace is what leaked rbind clones into /dev and broke binder for the
  # whole system on teardown, so fail closed instead.
  if [ "${DAEPILOT_PRIVATE_MNT_NS:-0}" != "1" ]; then
    fail "internal error: ensure_mounts called outside private mount namespace"
    return 1
  fi

  ensure_layout

  if ! is_mounted "$ROOTFS/proc"; then
    mount -t proc proc "$ROOTFS/proc" 2>/dev/null || true
  fi
  if ! is_mounted "$ROOTFS/dev"; then
    mount --rbind /dev "$ROOTFS/dev" 2>/dev/null || mount -o bind /dev "$ROOTFS/dev" 2>/dev/null || true
  fi
  # Mount only the sysfs subtrees dae actually reads. Binding all of /sys would
  # hide our pre-created /sys/fs/bpf mount point on devices where the host does
  # not have bpffs mounted yet.
  if [ -d /sys/class ] && ! is_mounted "$ROOTFS/sys/class"; then
    mount --rbind /sys/class "$ROOTFS/sys/class" 2>/dev/null || true
  fi
  if [ -d /sys/devices ] && ! is_mounted "$ROOTFS/sys/devices"; then
    mount --rbind /sys/devices "$ROOTFS/sys/devices" 2>/dev/null || true
  fi
  if [ -d /sys/kernel/btf ] && ! is_mounted "$ROOTFS/sys/kernel/btf"; then
    mount --rbind /sys/kernel/btf "$ROOTFS/sys/kernel/btf" 2>/dev/null || true
  fi
  # cgroup2 is needed for dae's cgroup connect hooks.
  if [ -d /sys/fs/cgroup ] && ! is_mounted "$ROOTFS/sys/fs/cgroup"; then
    mount --rbind /sys/fs/cgroup "$ROOTFS/sys/fs/cgroup" 2>/dev/null || true
  fi
  # /run stays a plain directory. A private tmpfs would be invisible to the
  # host-side watchdog, hiding dae.pid from daemon_pid and status.
  mkdir -p "$ROOTFS/run" 2>/dev/null
  chmod 755 "$ROOTFS/run" 2>/dev/null
  if ! is_mounted "$ROOTFS/sys/fs/bpf"; then
    mount -t bpf bpf "$ROOTFS/sys/fs/bpf" 2>/dev/null || \
      mount --rbind /sys/fs/bpf "$ROOTFS/sys/fs/bpf" 2>/dev/null || true
  fi
}

# Appends a resolver unless it is unusable or already listed.
add_nameserver() {
  ns="$1"
  # Android's dumpsys prints resolvers as "/10.0.2.3"; brackets, zone ids and
  # separators can also survive the shell split. A leading slash makes the
  # whole resolv.conf invalid, so dae's Go resolver silently falls back to
  # [::1]:53 and the network check/bootstrap fail.
  ns="${ns#/}"
  ns="${ns#[}"
  ns="${ns%]}"
  ns="${ns%%\%*}"
  ns="$(printf '%s' "$ns" | tr -d ' \r\t,')"
  case "$ns" in
    ""|*[!0-9A-Fa-f:.]*) return 0 ;;
  esac
  case "$ns" in
    "0.0.0.0"|"::"|"::1"|127.*|fe80:*|169.254.*) return 0 ;;
  esac
  case "$ns" in
    *:*) [ "${HAS_IPV6:-1}" = "1" ] || return 0 ;;
  esac
  grep -qx "nameserver $ns" "$resolv_tmp" 2>/dev/null && return 0
  echo "nameserver $ns" >> "$resolv_tmp"
}

# Cache `dumpsys connectivity` in a file. Beyond being reused by both the
# resolver and the DNS upstream logic, the dump can exceed the 128KB limit for
# a single execve argument, which breaks printf/echo-based parsing.
refresh_connectivity_dump() {
  have dumpsys || return 1
  mkdir -p "$RUN" 2>/dev/null
  if have timeout; then
    timeout 8 dumpsys connectivity > "$CONNECTIVITY_DUMP.tmp" 2>/dev/null
  else
    dumpsys connectivity > "$CONNECTIVITY_DUMP.tmp" 2>/dev/null
  fi
  if [ -s "$CONNECTIVITY_DUMP.tmp" ]; then
    mv "$CONNECTIVITY_DUMP.tmp" "$CONNECTIVITY_DUMP" 2>/dev/null
    return 0
  fi
  rm -f "$CONNECTIVITY_DUMP.tmp" 2>/dev/null
  [ -s "$CONNECTIVITY_DUMP" ]
}

write_resolv() {
  mkdir -p "$ROOTFS/etc" 2>/dev/null
  resolv_tmp="$ROOTFS/etc/resolv.conf.new"
  : > "$resolv_tmp"

  # Android's Go resolver cannot use an IPv6 nameserver when the device has
  # no IPv6 default route; including one only adds timeouts.
  HAS_IPV6=0
  if have ip && ip -6 route show default 2>/dev/null | grep -q .; then
    HAS_IPV6=1
  fi

  # dumpsys is the live source of truth. Read it even when the app already
  # published DNS: after a Wi-Fi/cellular switch run/dns.servers can still
  # contain the previous network's resolvers. Keep the output in a file: the
  # dump is far beyond the 128KB single-argument limit of execve.
  if refresh_connectivity_dump; then
    # Lead with the active WAN's resolvers: the dump also lists IMS/VPN
    # networks whose DNS can be unreachable from the default link, and Go's
    # resolver gives up quickly when the first nameserver does not answer.
    active_wan="$(detect_wan_interface 2>/dev/null)"
    if [ -n "$active_wan" ]; then
      wan_ipv4_dns "$active_wan" | while IFS= read -r ns; do
        add_nameserver "$ns"
      done
    fi
    sed -n 's/.*DnsAddresses: \[\([^]]*\)\].*/\1/p' "$CONNECTIVITY_DUMP" \
      | tr ', ' '\n\n' \
      | while IFS= read -r ns; do
          add_nameserver "$ns"
        done
  fi

  # The app-published list is a supplement (and covers ROMs where dumpsys is
  # unavailable). Keep it after the live values so a stale entry cannot win.
  if [ -s "$DNS_SERVERS" ]; then
    while IFS= read -r ns; do
      add_nameserver "$(printf '%s' "$ns" | tr -d ' \r\t')"
    done < "$DNS_SERVERS"
  fi

  for prop in net.dns1 net.dns2 net.dns3 net.dns4; do
    add_nameserver "$(getprop "$prop" 2>/dev/null | tr -d ' \r\t')"
  done

  if [ ! -s "$resolv_tmp" ]; then
    # Last resort. DNSPod first: Alibaba's 223.5.5.5 is dropped on some
    # cellular networks, while 119.29.29.29 kept answering on those links.
    for ns in 119.29.29.29 114.114.114.114 223.5.5.5 223.6.6.6; do
      add_nameserver "$ns"
    done
  fi

  mv "$resolv_tmp" "$ROOTFS/etc/resolv.conf" 2>/dev/null
  chmod 644 "$ROOTFS/etc/resolv.conf" 2>/dev/null

  if [ -f /system/etc/hosts ]; then
    cp /system/etc/hosts "$ROOTFS/etc/hosts" 2>/dev/null
  else
    echo "127.0.0.1 localhost" > "$ROOTFS/etc/hosts"
  fi
  chmod 644 "$ROOTFS/etc/hosts" 2>/dev/null

  echo "root:x:0:0:root:/root:/bin/sh" > "$ROOTFS/etc/passwd"
  echo "root:x:0:" > "$ROOTFS/etc/group"
  chmod 644 "$ROOTFS/etc/passwd" "$ROOTFS/etc/group" 2>/dev/null
}

write_ca_bundle() {
  bundle="$ROOTFS/etc/ssl/certs/ca-certificates.crt"
  mkdir -p "$ROOTFS/etc/ssl/certs" 2>/dev/null
  : > "$bundle"
  for dir in /apex/com.android.conscrypt/cacerts /system/etc/security/cacerts /data/misc/user/0/cacerts-added; do
    [ -d "$dir" ] || continue
    for cert in "$dir"/*.0 "$dir"/*.pem; do
      [ -f "$cert" ] || continue
      cat "$cert" >> "$bundle" 2>/dev/null || true
    done
  done
  if [ ! -s "$bundle" ]; then
    rm -f "$bundle" 2>/dev/null
  else
    chmod 644 "$bundle" 2>/dev/null
  fi
}

# Android keeps the real default route out of the main table on cellular
# (per-network policy routing), so dae's own "auto" detection can come back
# empty and leave the daemon without a datapath. Pick the first policy table
# that carries a usable default route instead.
detect_default_table() {
  local table route dev active_dev tables
  # The first policy table is not always the active default network (Wi-Fi
  # can be preferred while a mobile table still comes first). Ask the kernel
  # which interface an ordinary socket would use, then prefer the table that
  # routes out of that interface.
  active_dev=""
  if have ip; then
    active_dev="$(ip route get 1.1.1.1 2>/dev/null \
      | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1)"
  fi
  tables="$(ip rule 2>/dev/null | sed -n 's/.* lookup \([^ ]*\).*/\1/p')"
  for table in $tables; do
    case "$table" in
      ""|dummy0|*[!A-Za-z0-9_.-]*) continue ;;
    esac
    route="$(ip route show table "$table" 2>/dev/null | grep -m 1 '^default')"
    [ -n "$route" ] || continue
    case "$route" in
      *" dev dummy0"*|*" dev lo"*|*blackhole*|*unreachable*|*prohibit*|*throw*) continue ;;
    esac
    dev="$(printf '%s\n' "$route" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
    case "$dev" in tun*|tap*|wg*) continue ;; esac
    if [ -n "$active_dev" ] && [ "$dev" = "$active_dev" ]; then
      printf '%s\n' "$table"
      return 0
    fi
  done
  # No table matched the active default (e.g. a VPN owns the default route);
  # fall back to the first usable physical table.
  for table in $tables; do
    case "$table" in
      ""|dummy0|*[!A-Za-z0-9_.-]*) continue ;;
    esac
    route="$(ip route show table "$table" 2>/dev/null | grep -m 1 '^default')"
    [ -n "$route" ] || continue
    case "$route" in
      *" dev dummy0"*|*" dev lo"*|*blackhole*|*unreachable*|*prohibit*|*throw*) continue ;;
    esac
    # A VPN tun/tap/wg default must not become dae's WAN: binding it creates
    # a loop and the proxy loses the physical link after a VPN reconnect.
    dev="$(printf '%s\n' "$route" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
    case "$dev" in tun*|tap*|wg*) continue ;; esac
    printf '%s\n' "$table"
    return 0
  done
  return 1
}

detect_wan_interface() {
  local table route dev
  table="$(detect_default_table)" || return 1
  route="$(ip route show table "$table" 2>/dev/null | grep -m 1 '^default')"
  dev="$(printf '%s\n' "$route" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
  [ -n "$dev" ] || return 1
  ip link show "$dev" 2>/dev/null | grep -q "UP" || return 1
  ip -4 addr show dev "$dev" 2>/dev/null | grep -q "inet " || return 1
  printf '%s\n' "$dev"
}

# Print up to two IPv4 resolvers of the active WAN. Several cellular carriers
# drop queries to public resolvers such as 119.29.29.29 while their own
# resolvers keep working, so dae's domestic upstream must follow the network.
wan_ipv4_dns() {
  local wan line ns addr seen n
  wan="$1"
  [ -n "$wan" ] || return 0
  [ -s "$CONNECTIVITY_DUMP" ] || refresh_connectivity_dump || return 0
  line="$(grep -F "InterfaceName: $wan" "$CONNECTIVITY_DUMP" 2>/dev/null | head -n 1)"
  # Some ROMs omit InterfaceName; fall back to the first network with DNS.
  [ -n "$line" ] || line="$(grep -F 'DnsAddresses:' "$CONNECTIVITY_DUMP" 2>/dev/null | head -n 1)"
  [ -n "$line" ] || return 0
  ns="$(printf '%s\n' "$line" | sed -n 's/.*DnsAddresses: \[\([^]]*\)\].*/\1/p')"
  [ -n "$ns" ] || return 0
  seen=" "
  n=0
  for addr in $(printf '%s' "$ns" | tr ', ' '\n\n'); do
    addr="${addr#/}"
    addr="${addr%%\%*}"
    case "$addr" in ""|*[!0-9.]*) continue ;; esac
    case "$addr" in 0.0.0.0|127.*|169.254.*) continue ;; esac
    case "$seen" in *" $addr "*) continue ;; esac
    seen="$seen$addr "
    printf '%s\n' "$addr"
    n=$((n + 1))
    [ "$n" -ge 2 ] && break
  done
}

# Copy a rendered config into place, replacing dae's "auto" WAN with the
# interface Android is actually using. The app keeps writing "auto" so the
# same rendered config remains portable across Wi-Fi and cellular.
# The built-in domestic resolver is swapped for the WAN's live resolver for
# the same reason; a customized upstream is left untouched.
# dae's bootstrap resolver does not consult /etc/hosts on this build, so a
# node URL left as a hostname cannot be dialed when public DNS is blocked.
# Replace pinned hostnames with the IPv4 addresses resolved by
# write_node_hosts and keep loop protection in sync.
pin_node_urls() {
  local file tmp ip host esc
  file="$1"
  [ -f "$file" ] || return 0
  [ -s "$NODE_HOSTS_CACHE" ] || return 0
  tmp="$file.pin.$$"
  cp "$file" "$tmp" 2>/dev/null || return 0
  while read -r ip host; do
    case "$ip" in ""|*[!0-9.]*) continue ;; esac
    case "$host" in ""|*[!A-Za-z0-9.-]*) continue ;; esac
    esc="$(printf '%s' "$host" | sed 's/\./\\./g')"
    if sed -e "s/@$esc:/@$ip:/g" -e "s/domain($esc)/dip($ip)/g" \
        "$tmp" > "$tmp.next" 2>/dev/null; then
      mv "$tmp.next" "$tmp" 2>/dev/null
    else
      rm -f "$tmp.next" 2>/dev/null
    fi
  done < "$NODE_HOSTS_CACHE"
  if [ -s "$tmp" ]; then
    mv "$tmp" "$file" 2>/dev/null
    # The rewrite replaces the file, so restore the private mode dae requires.
    chmod 600 "$file" 2>/dev/null
  else
    rm -f "$tmp" 2>/dev/null
  fi
}

# dae's DNS hijack captures its own direct upstream queries to public
# resolvers on rmnet, so direct DNS times out on cellular even though the
# carrier resolvers answer raw queries. Send domestic lookups through the
# proxy's googledns instead; Wi-Fi/private resolvers keep the direct path.
apply_cellular_dns_mode() {
  local file wan tmp
  file="$1"
  wan="$2"
  case "$wan" in rmnet*) ;; *) return 0 ;; esac
  grep -q 'googledns:' "$file" 2>/dev/null || return 0
  [ -n "$(proxy_node_hosts "$file" 2>/dev/null)" ] || return 0
  # A domestic DoH upstream (HTTPS/TLS) does not use port 53, so the
  # rmnet self-capture workaround is unnecessary. Keep CN names on it
  # instead of forcing them through the slower foreign DoH.
  grep -qE "alidns: '(https|tls)://" "$file" 2>/dev/null && return 0
  tmp="$file.cdns.$$"
  if sed 's/^\([[:space:]]*qname(geosite:cn)[[:space:]]*->[[:space:]]*\)alidns[[:space:]]*$/\1googledns/' \
      "$file" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$file" 2>/dev/null
    chmod 600 "$file" 2>/dev/null
  else
    rm -f "$tmp" 2>/dev/null
  fi
}

# IPv4-only proxies cannot reach IPv6 targets. Chrome prefers AAAA and then
# hangs on the failed proxy dial (Play Store uses IPv4 and keeps working).
# Drop AAAA for proxied (non-CN) domains while keeping domestic IPv6 direct.
apply_ipv4_only_dns() {
  local file tmp
  file="$1"
  grep -q 'qtype(AAAA)' "$file" 2>/dev/null && return 0
  grep -q 'googledns:' "$file" 2>/dev/null || return 0
  [ -n "$(proxy_node_hosts "$file" 2>/dev/null)" ] || return 0
  tmp="$file.aaaa.$$"
  if sed '/^[[:space:]]*request[[:space:]]*{/a\      qtype(AAAA) && !qname(geosite:cn) -> reject' \
      "$file" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$file" 2>/dev/null
    chmod 600 "$file" 2>/dev/null
  else
    rm -f "$tmp" 2>/dev/null
  fi
}

stage_config() {
  local src dst wan tmp norm dns1
  src="$1"
  dst="$2"
  wan="$(detect_wan_interface 2>/dev/null)"
  dns1=""
  [ -n "$wan" ] && dns1="$(wan_ipv4_dns "$wan" 2>/dev/null | head -n 1)"
  tmp="$dst.tmp.$$"
  norm="$dst.norm.$$"
  # Normalize CRLF first: a Windows-edited config otherwise fails to match
  # "wan_interface: auto" and the daemon silently keeps dae's broken auto mode.
  if tr -d '\r' < "$src" > "$norm" 2>/dev/null; then
    if [ -n "$wan" ] && [ -n "$dns1" ]; then
      sed -e "s/^\([[:space:]]*wan_interface:[[:space:]]*\)auto[[:space:]]*$/\1$wan/" \
        -e "s/^\([[:space:]]*alidns:[[:space:]]*\)'udp:\/\/119\.29\.29\.29:53'/\1'udp:\/\/$dns1:53'/" \
        "$norm" > "$tmp" 2>/dev/null
    elif [ -n "$wan" ]; then
      sed "s/^\([[:space:]]*wan_interface:[[:space:]]*\)auto[[:space:]]*$/\1$wan/" \
        "$norm" > "$tmp" 2>/dev/null
    elif [ -n "$dns1" ]; then
      sed "s/^\([[:space:]]*alidns:[[:space:]]*\)'udp:\/\/119\.29\.29\.29:53'/\1'udp:\/\/$dns1:53'/" \
        "$norm" > "$tmp" 2>/dev/null
    else
      cp "$norm" "$tmp" 2>/dev/null
    fi
    rm -f "$norm" 2>/dev/null
    if [ -s "$tmp" ] && mv "$tmp" "$dst" 2>/dev/null; then
      pin_node_urls "$dst"
      apply_cellular_dns_mode "$dst" "$wan"
      apply_ipv4_only_dns "$dst"
      return 0
    fi
    rm -f "$tmp" 2>/dev/null
  fi
  rm -f "$norm" 2>/dev/null
  cp "$src" "$dst"
  apply_cellular_dns_mode "$dst" "$wan"
  apply_ipv4_only_dns "$dst"
}

# Hostnames referenced by the proxy group, one per line. Shared by the hosts
# pinning and by live-reload change detection.
proxy_node_hosts() {
  local config filters tag line host
  config="$1"
  [ -f "$config" ] || return 0
  filters="$(sed -n '/^[[:space:]]*proxy[[:space:]]*{/,/^[[:space:]]*}/p' "$config" 2>/dev/null \
    | sed -n 's/.*filter:[[:space:]]*name(\([^)]*\)).*/\1/p' \
    | tr ',' '\n' | tr -d "'\" " | sed '/^$/d')"
  if [ -n "$filters" ]; then
    for tag in $filters; do
      line="$(grep -m 1 "^[[:space:]]*$tag:" "$config" 2>/dev/null)"
      [ -n "$line" ] || continue
      host="$(printf '%s\n' "$line" | sed -n "s/.*@\([^:/?#']*\)[:/].*/\1/p")"
      [ -n "$host" ] && printf '%s\n' "$host"
    done
  else
    sed -n "s/^[[:space:]]*[^:]*:[[:space:]]*'[^']*@\([^:/?#']*\)[:/][^']*'.*/\1/p" \
      "$config" 2>/dev/null | head -n 4
  fi
}

# Resolve the proxy nodes' server hostnames through Android's system resolver
# and pin them in the chroot's /etc/hosts. dae's Go resolver then does not need
# to ask a public resolver for the node, which is what closes the
# "resolve node -> use proxy -> proxy needs node" loop on cellular networks
# that drop public DNS.
write_node_hosts() {
  local hosts_file cache_tmp hosts host ip running
  hosts_file="$ROOTFS/etc/hosts"
  [ -f "$hosts_file" ] || return 0
  [ -f "$ROOTFS/config/config.dae" ] || return 0

  cache_tmp="$NODE_HOSTS_CACHE.tmp.$$"
  : > "$cache_tmp" 2>/dev/null
  running=0
  if is_running; then
    # Keep the pins resolved at startup. Hosts added by a live config apply
    # are resolved below through dae's now-working DNS path.
    running=1
    if [ -s "$NODE_HOSTS_CACHE" ]; then
      cat "$NODE_HOSTS_CACHE" >> "$hosts_file"
      cp "$NODE_HOSTS_CACHE" "$cache_tmp"
    fi
  fi

  # Prefer hosts referenced by the proxy group; a large subscription must not
  # turn startup into a serial ping storm.
  hosts="$(proxy_node_hosts "$ROOTFS/config/config.dae" 2>/dev/null | tr '\n' ' ')"

  for host in $hosts; do
    case "$host" in
      ""|localhost|*[!A-Za-z0-9.-]*) continue ;;
    esac
    case "$host" in
      *[A-Za-z]*) ;;
      *) continue ;; # already an IP literal
    esac
    grep -q "[[:space:]]$host$" "$cache_tmp" 2>/dev/null && continue
    ip="$(ping -c 1 -W 2 "$host" 2>/dev/null \
      | sed -n 's/^PING [^(]*(\([0-9a-fA-F:.]*\)).*/\1/p' | head -n 1)"
    case "$ip" in
      ""|*:*) continue ;; # only stable IPv4 pins
    esac
    printf '%s %s\n' "$ip" "$host" >> "$cache_tmp"
    [ "$running" = "1" ] && printf '%s %s\n' "$ip" "$host" >> "$hosts_file"
  done

  if [ -s "$cache_tmp" ]; then
    mv "$cache_tmp" "$NODE_HOSTS_CACHE" 2>/dev/null
    [ "$running" = "0" ] && cat "$NODE_HOSTS_CACHE" >> "$hosts_file" 2>/dev/null
  else
    rm -f "$cache_tmp" 2>/dev/null
  fi
}

prepare_chroot() {
  ensure_layout
  write_resolv
  write_ca_bundle
  # Keep the static binary inside the chroot; dae is not dynamically linked,
  # but this also makes the path stable for `dae validate` and `dae reload`.
  if [ -x "$DAE" ]; then
    if [ ! -f "$ROOTFS/bin/dae" ] || ! cmp -s "$DAE" "$ROOTFS/bin/dae"; then
      cp "$DAE" "$ROOTFS/bin/dae" 2>/dev/null || cp "$DAE" "$ROOTFS/bin/dae"
      chmod 755 "$ROOTFS/bin/dae" 2>/dev/null
    fi
  fi
  if [ -f "$CONF" ]; then
    stage_config "$CONF" "$ROOTFS/config/config.dae" 2>/dev/null
    chmod 600 "$ROOTFS/config/config.dae" 2>/dev/null
  fi
  ensure_geodata || return 1
  write_node_hosts
  pin_node_urls "$ROOTFS/config/config.dae"
  chmod 700 "$ROOTFS/config" 2>/dev/null
}

# Remember what the daemon actually bound. The watchdog uses this to restart
# when Android switches networks (Wi-Fi <-> cellular).
record_wan_binding() {
  local wan
  wan="$(sed -n 's/^[[:space:]]*wan_interface:[[:space:]]*\([^[:space:]]*\).*/\1/p' \
    "$ROOTFS/config/config.dae" 2>/dev/null | head -n 1)"
  if [ -n "$wan" ] && [ "$wan" != "auto" ]; then
    printf '%s\n' "$wan" > "$WAN_FILE" 2>/dev/null
  else
    rm -f "$WAN_FILE" 2>/dev/null
  fi
  if grep -qE '^[[:space:]]*wan_interface:[[:space:]]*auto' "$CONF" 2>/dev/null; then
    : > "$WAN_AUTO" 2>/dev/null
  else
    rm -f "$WAN_AUTO" 2>/dev/null
  fi
  rm -f "$WAN_CANDIDATE" "$WAN_CANDIDATE_COUNT" 2>/dev/null
}

# dae looks for geosite.dat/geoip.dat next to the config file. The copies are
# large, so only replace them when the size differs (upgrade/repair).
ensure_geodata() {
  # Do not leak src/dest into callers such as apply_config: this loop used to
  # overwrite apply_config's staged config path with geoip.dat.
  local name src dest a b
  mkdir -p "$ROOTFS/config" 2>/dev/null
  for name in geosite.dat geoip.dat; do
    src="$GEO_DIR/$name"
    dest="$ROOTFS/config/$name"
    if [ -f "$dest" ] && [ -f "$src" ]; then
      a="$(wc -c < "$dest" 2>/dev/null | tr -dc '0-9')"
      b="$(wc -c < "$src" 2>/dev/null | tr -dc '0-9')"
      [ -n "$a" ] && [ "$a" = "$b" ] && continue
    fi
    if [ -f "$src" ]; then
      cp "$src" "$dest" 2>/dev/null || { fail "无法安装地理数据：$name"; return 1; }
      chmod 644 "$dest" 2>/dev/null
    elif [ ! -f "$dest" ]; then
      fail "缺少地理数据 $name，请重新安装 DaePilot 模块"
      return 1
    fi
  done
  return 0
}

# Re-exec the controller inside a throwaway mount namespace, prepare the
# chroot there and exec the target command. Every mount created here dies with
# the namespace; the shared host namespace is never touched, so no umount is
# needed (or allowed) on teardown.
# True when this namespace's root mount is not in a propagation peer group.
# unshare(2) already clones the tree as private on many kernels, so the usual
# case needs no mount(8) call at all. The exit status of mount -o rprivate is
# not usable as evidence: busybox treats a lone directory as an fstab lookup
# and toybox accepts unknown -o flags without applying them.
ns_root_is_private() {
  local line
  if [ -n "$BB" ]; then
    line="$("$BB" awk '$5 == "/" { print; exit }' /proc/self/mountinfo 2>/dev/null)"
  else
    line="$(awk '$5 == "/" { print; exit }' /proc/self/mountinfo 2>/dev/null)"
  fi
  [ -n "$line" ] || return 1
  case "$line" in
    *" shared:"*) return 1 ;;
  esac
  return 0
}

exec_in_private_ns() {
  if [ -z "$BB" ]; then
    echo "daepilot: 需要 busybox 的 mount -o rprivate，拒绝在宿主 mount namespace 继续" >&2
    return 1
  fi

  # Android's root mount is shared. Without making the copied namespace
  # private, --rbind /dev joins the host peer group and a later umount
  # propagates to the host (this is how /dev/binderfs disappeared).
  if ! ns_root_is_private; then
    "$BB" mount -o remount,rprivate / 2>/dev/null || true
    ns_root_is_private \
      || { echo "daepilot: cannot make mount namespace private" >&2; return 1; }
  fi

  export DAEPILOT_PRIVATE_MNT_NS=1
  ensure_mounts || return 1
  exec "$BB" chroot "$ROOTFS" "$@"
}

run_chroot() {
  if [ -n "$BB" ]; then
    "$BB" unshare -m "$CTL" __run_in_ns "$@"
  else
    unshare -m "$CTL" __run_in_ns "$@"
  fi
}

# True when $1 is a live dae started from our chroot config. The variables are
# local on purpose: a global `pid` here overwrote the caller's candidate, which
# made daemon_pid echo a stale pid after its pid-file probe failed.
is_our_dae() {
  local pid="$1" state cmd
  case "$pid" in ""|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  # kill -0 also succeeds for an unreaped zombie, which holds no sockets and
  # would make status claim the daemon is up while the proxy is dead.
  state="$(sed -n 's/^.*) \(.\).*$/\1/p' "/proc/$pid/stat" 2>/dev/null)"
  [ "$state" = "Z" ] && return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  cmd="$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
  case "$cmd" in
    *"run -c /config/config.dae"*) return 0 ;;
  esac
  return 1
}

# Every live dae, including instances whose pid file was lost. The app, the
# script and the watchdog can run in different mount namespaces, so the pid
# files are not authoritative.
# List PIDs whose full command line contains the given literal string.
# toybox grep has no -a and skips NUL-separated /proc/*/cmdline files, so a
# single `ps` pass is the portable way to find processes on Android.
process_pids_matching() {
  ps -A -o PID,ARGS 2>/dev/null | grep -F "$1" | grep -v grep \
    | while read -r pid rest; do
        case "$pid" in ''|*[!0-9]*) continue ;; esac
        echo "$pid"
      done
}

dae_pids() {
  found=""
  if have pidof; then
    for pid in $(pidof dae 2>/dev/null); do
      if is_our_dae "$pid"; then found="$found $pid"; fi
    done
  fi
  if [ -z "$found" ]; then
    for pid in $(process_pids_matching 'run -c /config/config.dae'); do
      if is_our_dae "$pid"; then found="$found $pid"; fi
    done
  fi
  for pid in $found; do echo "$pid"; done
}

watchdog_pid() {
  local state
  pid=""
  if [ -s "$WATCH_PID" ]; then
    candidate="$(tr -dc '0-9' < "$WATCH_PID" 2>/dev/null)"
    if [ -n "$candidate" ] && kill -0 "$candidate" 2>/dev/null; then
      state="$(sed -n 's/^.*) \(.\).*$/\1/p' "/proc/$candidate/stat" 2>/dev/null)"
      [ "$state" != "Z" ] && pid="$candidate"
    fi
  fi
  if [ -z "$pid" ]; then
    for candidate in $(process_pids_matching 'daepilotctl watch'); do
      [ "$candidate" = "$$" ] && continue
      state="$(sed -n 's/^.*) \(.\).*$/\1/p' "/proc/$candidate/stat" 2>/dev/null)"
      [ "$state" = "Z" ] && continue
      pid="$candidate"; break
    done
  fi
  [ -n "$pid" ] || return 1
  echo "$pid"
  return 0
}

daemon_pid() {
  pid=""
  for pid_file in "$DAE_PID" "$HOST_PID"; do
    [ -s "$pid_file" ] || continue
    candidate="$(tr -dc '0-9' < "$pid_file" 2>/dev/null)"
    if is_our_dae "$candidate"; then
      pid="$candidate"
      break
    fi
  done
  if [ -z "$pid" ]; then
    pid="$(dae_pids 2>/dev/null | head -n 1)"
  fi
  [ -n "$pid" ] || return 1
  echo "$pid"
  return 0
}

is_running() { daemon_pid >/dev/null 2>&1; }

rotate_log() {
  size=0
  [ -f "$LOG" ] && size="$(wc -c < "$LOG" 2>/dev/null | tr -dc '0-9')"
  [ -n "$size" ] || size=0
  if [ "$size" -gt 5242880 ]; then
    mv "$LOG" "$LOG.1" 2>/dev/null
    : > "$LOG"
  fi
}

remove_dae_route() {
  local priority
  if have ip; then
    # Remove the current and formerly used reserved priorities so upgrades
    # migrate the rule to 9900 instead of leaving a stale duplicate behind.
    for priority in "$DAE_MARK_RULE_PRIORITY" "$DAE_MARK_LEGACY_PRIORITY"; do
      while ip rule del priority "$priority" 2>/dev/null; do :; done
      while ip -6 rule del priority "$priority" 2>/dev/null; do :; done
    done
  fi
}

ensure_dae_route() {
  have ip || { fail "找不到 ip 命令，无法配置 dae socket 路由"; return 1; }

  selected_table="$(detect_default_table)" || {
    fail "未找到可供 dae 使用的默认路由（已排除 dummy0/黑洞路由）"
    return 1
  }

  # Replace the reserved rule only after a usable table has been identified.
  remove_dae_route
  if ! ip rule add from all fwmark 0x100/0x1ffff table "$selected_table" priority "$DAE_MARK_RULE_PRIORITY" 2>/dev/null; then
    fail "无法添加 dae socket 路由规则（priority $DAE_MARK_RULE_PRIORITY, table $selected_table）"
    return 1
  fi

  # IPv6 keeps its own policy table set. Without a marked rule, dae's IPv6
  # sockets (e.g. an AAAA bootstrap resolver, or a v6-only network) fall
  # through to the terminal unreachable rule even when IPv4 works.
  # Prefer the table that routes out of the WAN interface dae is bound to;
  # Android also carries live v6 tables for other links (rmnet_data2 here),
  # and picking one of those sends marked traffic out the wrong link.
  v6_table=""
  v6_fallback=""
  wan_dev="$(detect_wan_interface 2>/dev/null)"
  for table in $(ip -6 rule 2>/dev/null | sed -n 's/.* lookup \([^ ]*\).*/\1/p'); do
    case "$table" in
      ""|dummy0|*[!A-Za-z0-9_.-]*) continue ;;
    esac
    route="$(ip -6 route show table "$table" 2>/dev/null | grep -m 1 '^default')"
    [ -n "$route" ] || continue
    case "$route" in
      *" dev dummy0"*|*" dev lo"*|*blackhole*|*unreachable*|*prohibit*|*throw*) continue ;;
    esac
    dev="$(printf '%s\n' "$route" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
    [ -n "$v6_fallback" ] || v6_fallback="$table"
    if [ -n "$wan_dev" ] && [ "$dev" = "$wan_dev" ]; then
      v6_table="$table"
      break
    fi
  done
  [ -n "$v6_table" ] || v6_table="$v6_fallback"
  if [ -n "$v6_table" ]; then
    ip -6 rule add from all fwmark 0x100/0x1ffff table "$v6_table" priority "$DAE_MARK_RULE_PRIORITY" 2>/dev/null || true
  fi
  return 0
}

validate_file() {
  file="$1"
  [ -f "$file" ] || { fail "配置文件不存在：$file"; return 1; }
  prepare_chroot || return 1
  mkdir -p "$ROOTFS/config" 2>/dev/null
  stage_config "$file" "$VALIDATE_CONF" 2>/dev/null || { fail "无法写入校验配置"; return 1; }
  chmod 600 "$VALIDATE_CONF" 2>/dev/null
  out="$(run_chroot /bin/dae validate -c "$VALIDATE_CONF_GUEST" 2>&1)"
  code=$?
  rm -f "$VALIDATE_CONF" 2>/dev/null
  if [ "$code" -ne 0 ]; then
    rotate_log
    {
      printf '\n=== %s config validation failed ===\n' "$(date '+%Y-%m-%d %H:%M:%S')"
      printf '%s\n' "$out"
    } >> "$LOG" 2>/dev/null
    # Surface dae's first meaningful output line in the error so the app event
    # log shows the real reason (e.g. "invalid config filename") instead of a
    # bare message; the complete output stays in the local daemon log.
    # Skip logrus lines: they typically precede the actual parse error.
    detail="$(printf '%s\n' "$out" | grep -v '^time=' | grep -m 1 . 2>/dev/null || true)"
    case "$detail" in
      "") fail "配置校验失败" ;;
      *) fail "配置校验失败：$detail" ;;
    esac
    return 1
  fi
  clear_error
  [ -n "$out" ] && say "$out"
  return 0
}

start_daemon() {
  ensure_layout
  [ -x "$DAE" ] || { fail "dae 二进制缺失：$DAE"; return 1; }
  [ -x "$CTL" ] || { fail "控制脚本缺失：$CTL"; return 1; }
  if is_running; then
    pid="$(daemon_pid)"
    echo "$pid" > "$HOST_PID" 2>/dev/null
    # The instance may have been adopted after a crash that also lost the
    # fwmark rule; restore it so dae's own dials keep working.
    ensure_dae_route >/dev/null 2>&1 || true
    say "already running (pid $pid)"
    return 0
  fi
  # Recover a fwmark rule left behind by a crash/reboot before revalidating.
  remove_dae_route
  # A crashed instance can leave its dae0 link behind; attaching the TC hook
  # to it then fails with "attach tcx link: no such device" and dae exits.
  if have ip; then
    for link in dae0 dae0peer; do
      if ip link show "$link" >/dev/null 2>&1; then
        ip link del "$link" 2>/dev/null || true
      fi
    done
  fi
  [ -f "$CONF" ] || { fail "尚未生成配置，请先在 App 中应用配置"; return 1; }

  prepare_chroot || return 1
  validate_file "$CONF" || return 1
  echo "config_valid=1" > "$CONFIG_OK"

  # Remember what the daemon actually bound. The watchdog restarts it when
  # Android switches networks (Wi-Fi <-> cellular) and the interface changes.
  record_wan_binding

  # dae marks its own sockets 0x100 to avoid self-capture. Android policy
  # routing needs an explicit lookup for that mark, otherwise the socket may
  # hit a terminal unreachable rule before reaching the network.
  ensure_dae_route || return 1

  raise_memlock
  rotate_log
  rm -f "$DAE_PID" "$HOST_PID" 2>/dev/null
  say "starting dae (chroot $ROOTFS)"
  printf '\n=== %s start ===\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG"

  # dae lives in its own mount namespace. The chroot mounts are created by
  # __run_in_ns inside that namespace and are destroyed automatically when
  # the daemon exits; nothing is mounted in (or unmounted from) the host.
  if [ -n "$BB" ]; then
    "$BB" setsid "$BB" unshare -m "$CTL" __run_in_ns /bin/dae run -c /config/config.dae --disable-sudo --disable-timestamp >> "$LOG" 2>&1 &
  elif have setsid; then
    setsid unshare -m "$CTL" __run_in_ns /bin/dae run -c /config/config.dae --disable-sudo --disable-timestamp >> "$LOG" 2>&1 &
  else
    unshare -m "$CTL" __run_in_ns /bin/dae run -c /config/config.dae --disable-sudo --disable-timestamp >> "$LOG" 2>&1 &
  fi
  launched=$!
  echo "$launched" > "$HOST_PID"

  # dae writes /var/run/dae.pid inside the chroot; prefer that pid because
  # setsid may fork and make $! the parent that exits immediately.
  i=0
  while [ "$i" -lt 20 ]; do
    if is_running; then
      pid="$(daemon_pid)"
      echo "$pid" > "$HOST_PID"
      sleep 1
      if is_running; then
        clear_error
        say "running (pid $pid)"
        return 0
      fi
      break
    fi
    sleep 0.5 2>/dev/null || sleep 1
    i=$((i + 1))
  done

  tail -n 20 "$LOG" 2>/dev/null >&2
  remove_dae_route
  fail "dae 启动失败，请查看日志"
  return 1
}

stop_daemon() {
  pids="$(dae_pids 2>/dev/null)"
  if [ -n "$pids" ]; then
    for pid in $pids; do
      kill "$pid" 2>/dev/null
    done
    i=0
    while [ "$i" -lt 20 ]; do
      alive=""
      for pid in $pids; do
        is_our_dae "$pid" && alive="$alive $pid"
      done
      [ -z "$alive" ] && break
      sleep 0.5 2>/dev/null || sleep 1
      i=$((i + 1))
    done
    for pid in $pids; do
      is_our_dae "$pid" && kill -9 "$pid" 2>/dev/null
    done
    say "stopped (pid $pids)"
  else
    say "not running"
  fi
  rm -f "$DAE_PID" "$HOST_PID" 2>/dev/null
  remove_dae_route
}

do_reload() {
  if ! is_running; then
    fail "dae 未运行，无法热重载"
    return 1
  fi
  prepare_chroot || return 1
  record_wan_binding
  ensure_dae_route || return 1
  # Run the reload CLI in a private mount namespace as well: it needs the
  # chroot's /proc and /dev, which no longer exist in the host namespace.
  if have timeout; then
    if [ -n "$BB" ]; then
      out="$(timeout 90 "$BB" unshare -m "$CTL" __run_in_ns /bin/dae reload 2>&1)"
    else
      out="$(timeout 90 unshare -m "$CTL" __run_in_ns /bin/dae reload 2>&1)"
    fi
  else
    out="$(run_chroot /bin/dae reload 2>&1)"
  fi
  code=$?
  printf '%s\n' "$out"
  if [ "$code" -ne 0 ]; then
    set_error "热重载失败：$out"
    return 1
  fi
  clear_error
  return 0
}

apply_config() {
  src="$1"
  do_reload_flag="$2"
  [ -f "$src" ] || { fail "暂存配置不存在：$src"; return 1; }
  local old_hosts new_hosts
  old_hosts="$(proxy_node_hosts "$CONF" 2>/dev/null | sort -u)"
  validate_file "$src" || return 1

  mkdir -p "$CONF_DIR" 2>/dev/null
  if [ -f "$CONF" ]; then
    cp "$CONF" "$BAK" 2>/dev/null
    chmod 600 "$BAK" 2>/dev/null
  fi
  cp "$src" "$CONF" 2>/dev/null || { fail "无法写入配置"; return 1; }
  chmod 600 "$CONF" 2>/dev/null
  stage_config "$CONF" "$ROOTFS/config/config.dae" 2>/dev/null
  chmod 600 "$ROOTFS/config/config.dae" 2>/dev/null
  write_node_hosts
  new_hosts="$(proxy_node_hosts "$CONF" 2>/dev/null | sort -u)"

  if [ "$do_reload_flag" = "--reload" ] && is_running; then
    # A hot reload cannot re-resolve a changed node host reliably: the daemon
    # is already capturing DNS. Restart once instead so start_daemon resolves
    # the new server while the datapath is down.
    if [ "$old_hosts" != "$new_hosts" ]; then
      say "节点服务器已变化，重启 dae 以重新解析节点地址"
      stop_daemon
      if start_daemon; then
        echo "config_valid=1" > "$CONFIG_OK"
        say "配置已应用并重启 daemon"
        return 0
      fi
      say "节点变化后 dae 启动失败，尝试回滚"
    elif do_reload; then
      echo "config_valid=1" > "$CONFIG_OK"
      say "配置已应用并热重载"
      return 0
    fi
    # Only restore a backup that still validates. A polluted main config may
    # have been backed up previously (e.g. the geoip.dat overwrite caused by
    # variable leakage in old ctl versions); blindly restoring it would keep
    # the daemon dead with a broken config.
    if [ -f "$BAK" ] && validate_file "$BAK"; then
      say "热重载失败，回滚并重启 daemon"
      cp "$BAK" "$CONF" 2>/dev/null
      stage_config "$BAK" "$ROOTFS/config/config.dae" 2>/dev/null
      stop_daemon
      start_daemon
      fail "新配置热重载失败，已回滚到上一版"
      return 1
    fi
    stop_daemon
    fail "新配置热重载失败，且备份配置校验未通过，未执行回滚"
    return 1
  fi
  echo "config_valid=1" > "$CONFIG_OK"
  say "配置已写入（daemon 未运行或未请求重载）"
  return 0
}

ensure_watchdog() {
  if existing="$(watchdog_pid 2>/dev/null)"; then
    echo "$existing" > "$WATCH_PID" 2>/dev/null
    return 0
  fi
  mkdir -p "$RUN" 2>/dev/null
  if [ -n "$BB" ]; then
    "$BB" setsid "$CTL" watch >> "$WLOG" 2>&1 &
  elif have setsid; then
    setsid "$CTL" watch >> "$WLOG" 2>&1 &
  else
    nohup "$CTL" watch >> "$WLOG" 2>&1 &
  fi
  say "watchdog started"
}

stop_watchdog() {
  if wpid="$(watchdog_pid 2>/dev/null)"; then
    kill "$wpid" 2>/dev/null
  fi
  rm -f "$WATCH_PID" 2>/dev/null
}

watch_loop() {
  mkdir -p "$RUN" 2>/dev/null
  # A second watchdog would race the first one on every restart; the pid file
  # alone cannot detect one started from another mount namespace.
  others=""
  for dir in /proc/[0-9]*; do
    other="${dir#/proc/}"
    [ "$other" = "$$" ] && continue
    [ -r "$dir/cmdline" ] || continue
    cmd="$(tr '\000' ' ' < "$dir/cmdline" 2>/dev/null)"
    case "$cmd" in
      *"daepilotctl watch"*) others="$others $other" ;;
    esac
  done
  if [ -n "$others" ]; then
    say "watchdog already running (pid$others)"
    exit 0
  fi
  echo $$ > "$WATCH_PID"
  trap 'rm -f "$WATCH_PID" 2>/dev/null; exit 0' TERM INT HUP
  say "watchdog $$ started"
  while [ -f "$ENABLED" ]; do
    if ! is_running; then
      rotate_watch_log
      say "[$(date '+%Y-%m-%d %H:%M:%S')] daemon down, restarting"
      start_daemon >> "$WLOG" 2>&1
    else
      # dae binds one interface name. Android swaps Wi-Fi/cellular interfaces
      # behind the same default route, so follow the change with a restart
      # instead of leaving the daemon attached to a dead link. Require the new
      # interface to win two consecutive checks: a flapping link must not
      # restart the daemon every 15 seconds.
      current_wan="$(detect_wan_interface 2>/dev/null)"
      bound_wan="$(head -n 1 "$WAN_FILE" 2>/dev/null)"
      if [ -f "$WAN_AUTO" ] && [ -n "$current_wan" ] && [ -n "$bound_wan" ] \
          && [ "$current_wan" != "$bound_wan" ]; then
        candidate="$(head -n 1 "$WAN_CANDIDATE" 2>/dev/null)"
        candidate_count="$(head -n 1 "$WAN_CANDIDATE_COUNT" 2>/dev/null)"
        case "$candidate_count" in ''|*[!0-9]*) candidate_count=0 ;; esac
        if [ "$candidate" = "$current_wan" ]; then
          candidate_count=$((candidate_count + 1))
        else
          candidate="$current_wan"
          candidate_count=1
        fi
        printf '%s\n' "$candidate" > "$WAN_CANDIDATE" 2>/dev/null
        printf '%s\n' "$candidate_count" > "$WAN_CANDIDATE_COUNT" 2>/dev/null
        if [ "$candidate_count" -ge 2 ]; then
          rotate_watch_log
          say "[$(date '+%Y-%m-%d %H:%M:%S')] WAN changed ($bound_wan -> $current_wan), restarting"
          rm -f "$WAN_CANDIDATE" "$WAN_CANDIDATE_COUNT" 2>/dev/null
          stop_daemon
          start_daemon >> "$WLOG" 2>&1
        fi
      else
        rm -f "$WAN_CANDIDATE" "$WAN_CANDIDATE_COUNT" 2>/dev/null
        if ! ip rule show 2>/dev/null | grep -q "fwmark 0x100/0x1ffff"; then
          # A reboot/network reset can drop the mark rule while dae keeps
          # running; without it dae's own dials hit the unreachable rule.
          ensure_dae_route >/dev/null 2>&1 || true
        fi
      fi
    fi
    sleep 15
  done
  say "watchdog $$ exiting (disabled)"
  rm -f "$WATCH_PID" 2>/dev/null
}

rotate_watch_log() {
  size=0
  [ -f "$WLOG" ] && size="$(wc -c < "$WLOG" 2>/dev/null | tr -dc '0-9')"
  [ -n "$size" ] || size=0
  if [ "$size" -gt 1048576 ]; then
    mv "$WLOG" "$WLOG.1" 2>/dev/null
    : > "$WLOG"
  fi
}

status() {
  pid="$(daemon_pid 2>/dev/null)"
  if [ -n "$pid" ]; then
    echo "running=1"
    echo "pid=$pid"
    uptime=0
    if [ -r "/proc/$pid/stat" ] && [ -r /proc/stat ]; then
      ticks="$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)"
      btime="$(awk '/^btime/ {print $2}' /proc/stat 2>/dev/null)"
      now="$(date +%s 2>/dev/null)"
      case "$ticks" in ''|*[!0-9]*) ticks=0 ;; esac
      case "$btime" in ''|*[!0-9]*) btime=0 ;; esac
      case "$now" in ''|*[!0-9]*) now=0 ;; esac
      if [ "$btime" -gt 0 ] && [ "$now" -ge "$btime" ]; then
        uptime=$((now - btime - ticks / 100))
        [ "$uptime" -lt 0 ] && uptime=0
      fi
    fi
    echo "uptime=$uptime"
    rss="$(awk '/^VmRSS:/ {print $2}' "/proc/$pid/status" 2>/dev/null)"
    echo "rss_kb=${rss:-0}"
  else
    echo "running=0"
  fi
  [ -f "$ENABLED" ] && echo "enabled=1" || echo "enabled=0"
  [ -f "$BOOT_ENABLED" ] && echo "boot_enabled=1" || echo "boot_enabled=0"
  [ -s "$CONFIG_OK" ] && echo "config_valid=1" || echo "config_valid=0"
  if watchdog_pid >/dev/null 2>&1; then
    echo "watchdog=1"
  else
    echo "watchdog=0"
  fi
  if [ -f "$VERSION_FILE" ]; then
    echo "version=$(head -n 1 "$VERSION_FILE" 2>/dev/null)"
  fi
  if [ -f "$LAST_ERROR" ]; then
    echo "last_error=$(head -n 1 "$LAST_ERROR" 2>/dev/null)"
  fi
  wan="$(head -n 1 "$WAN_FILE" 2>/dev/null)"
  echo "wan=$wan"
  wan_ip=""
  if [ -n "$wan" ] && have ip; then
    wan_ip="$(ip -4 addr show dev "$wan" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1)"
  fi
  echo "wan_ip=$wan_ip"
  node="$(sed -n "s/^[[:space:]]*\([A-Za-z0-9_.-]*\):[[:space:]]*'[^']*@\([^:/?#']*\):\([0-9]*\).*/\1 \2:\3/p" "$CONF" 2>/dev/null | head -n 1)"
  echo "node=$node"
  dns="$(tr '\n' ' ' < "$ROOTFS/etc/resolv.conf" 2>/dev/null | sed 's/nameserver //g; s/  */ /g; s/ $//')"
  echo "dns=$dns"
  dns_mode=direct
  grep -q 'qname(geosite:cn)[[:space:]]*->[[:space:]]*googledns' "$ROOTFS/config/config.dae" 2>/dev/null && dns_mode=proxy
  echo "dns_mode=$dns_mode"
  ipv6_mode=allow
  grep -q 'qtype(AAAA)' "$ROOTFS/config/config.dae" 2>/dev/null && ipv6_mode=blocked
  echo "ipv6_mode=$ipv6_mode"
  echo "mode=chroot"
}

diagnose() {
  echo "kernel=$(uname -r 2>/dev/null)"
  [ -e /sys/kernel/btf/vmlinux ] && echo "btf=1" || echo "btf=0"
  grep -q cgroup2 /proc/mounts 2>/dev/null && echo "cgroup2=1" || echo "cgroup2=0"
  echo "selinux=$(getenforce 2>/dev/null || echo Unknown)"
  echo "mem_available_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null)"
  [ -d /data/adb/modules/daepilot ] && echo "module=1" || echo "module=0"
  [ -x "$DAE" ] && echo "dae=1" || echo "dae=0"
  [ -f "$CONF" ] && echo "config=1" || echo "config=0"
  echo "dae_pids=$(dae_pids 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
  echo "watchdog_pid=$(watchdog_pid 2>/dev/null || echo 0)"
  echo "resolv=$(tr '\n' ' ' < "$ROOTFS/etc/resolv.conf" 2>/dev/null | sed 's/ $//')"
  echo "dns_file=$(tr '\n' ' ' < "$DNS_SERVERS" 2>/dev/null | sed 's/ $//')"
  echo "conflicts=$(ps -A -o NAME= 2>/dev/null | grep -cE '^(sing-box|clash|mihomo|xray|v2ray|hysteria)$')"
}

case "${1:-status}" in
  start)
    touch "$ENABLED" 2>/dev/null
    start_daemon || exit 1
    ensure_watchdog
    ;;
  stop)
    rm -f "$ENABLED" 2>/dev/null
    stop_watchdog
    stop_daemon
    ;;
  restart)
    touch "$ENABLED" 2>/dev/null
    stop_watchdog
    stop_daemon
    start_daemon || exit 1
    ensure_watchdog
    ;;
  reload)
    do_reload
    ;;
  enable)
    touch "$BOOT_ENABLED"
    say "boot start enabled"
    ;;
  disable)
    rm -f "$BOOT_ENABLED"
    say "boot start disabled"
    ;;
  apply)
    apply_config "$2" "$3"
    ;;
  validate)
    validate_file "${2:-$CONF}"
    ;;
  status)
    status
    ;;
  logs)
    lines="${2:-300}"
    case "$lines" in ''|*[!0-9]*) lines=300 ;; esac
    [ "$lines" -gt 5000 ] && lines=5000
    tail -n "$lines" "$LOG" 2>/dev/null
    ;;
  clearlog)
    : > "$LOG" 2>/dev/null
    say "log cleared"
    ;;
  diagnose)
    diagnose
    ;;
  watch)
    watch_loop
    ;;
  __run_in_ns)
    shift
    exec_in_private_ns "$@"
    ;;
  *)
    say "usage: $0 {start|stop|restart|reload|enable|disable|apply <file> [--reload]|validate [file]|status|logs [n]|clearlog|diagnose|watch}"
    exit 2
    ;;
esac
